# cleanroom-watcher production compose env. Copy to docker/prod/.env, chmod 600. Replace every change_me.
# Keep in sync with config.json: DB_* -> db_dsn, REDIS_PASSWORD -> redis_password,
# ADMIN_PATH -> admin.path (check with `make check-config`).

# --- Compose ---
COMPOSE_PROJECT_NAME=cleanroom-watcher
# Repo root, relative to this directory.
APP_PATH=../..
CONFIG_PATH=./config.json
# UID/GID of the host user that owns ./logs.
PUID=1000
PGID=1000
TZ=UTC
SCANNER_IMAGE=cleanroom-watcher-scanner
NGINX_IMAGE=cleanroom-watcher-nginx
MYSQL_IMAGE=cleanroom-watcher-mysql

# --- Nginx ---
APP_DOMAIN=example.com
# Must equal admin.path in config.json.
ADMIN_PATH=change_me
HTTP_PORT=80
CLIENT_MAX_BODY_SIZE=1m
# Loopback binds on the host.
SCANNER_HOST_BIND=127.0.0.1:8080
MYSQL_HOST_BIND=127.0.0.1:3306

# --- Database ---
DB_DATABASE=tron_scanner
DB_USERNAME=tron
DB_PASSWORD=change_me
DB_ROOT_PASSWORD=change_me
MYSQL_DATA_PATH=./data/mysql

# --- Redis ---
REDIS_PASSWORD=change_me
REDIS_DATA_PATH=./data/redis

# --- Resource limits ---
SCANNER_CPUS=2
SCANNER_MEMORY=1G
NGINX_CPUS=1
NGINX_MEMORY=256M
MYSQL_CPUS=2
MYSQL_MEMORY=1G
REDIS_CPUS=1
REDIS_MEMORY=512M
