[mysqld]
# --- Character sets ---
character-set-server = utf8mb4
collation-server = utf8mb4_unicode_ci
# skip-character-set-client-handshake was removed: 8.4 has no such option and the
# server will not start with it. The Go driver sends utf8mb4 on connect by itself.

# --- Network ---
# The container lives on the internal network; no port is published outside.
bind-address = 0.0.0.0
# A couple dozen is enough for the scanner: database/sql pool + webhook workers.
max_connections = 100
max_allowed_packet = 64M
wait_timeout = 600
interactive_timeout = 600

# --- Security ---
local_infile = 0
secure_file_priv = /var/lib/mysql-files
skip_name_resolve = 1
# symbolic-links = 0 is omitted: it is the default since 8.0, and setting it
# explicitly prints a deprecation warning (MY-011070).

# --- InnoDB ---
# buffer_pool ~50-70% of the container memory limit (MYSQL_MEMORY=1G).
# Most of the data is transfer_events, which grows monotonically.
innodb_buffer_pool_size = 512M
# innodb_log_file_size is deprecated (MY-013907); set the redo log capacity directly.
innodb_redo_log_capacity = 256M
innodb_flush_log_at_trx_commit = 1
innodb_flush_method = O_DIRECT
innodb_file_per_table = 1
innodb_io_capacity = 1000
innodb_io_capacity_max = 2000

# --- Binlog: required for PITR recovery ---
log_bin = mysql-bin
# binlog_format is not set: ROW is the default, and setting it explicitly
# is deprecated (MY-011070).
binlog_expire_logs_seconds = 604800
max_binlog_size = 256M

# --- Logs ---
slow_query_log = 1
slow_query_log_file = /var/lib/mysql/slow.log
long_query_time = 2
log_queries_not_using_indexes = 0
log_error_verbosity = 2

# --- Time ---
# The application runs in UTC (loc=UTC in db_dsn); the server must be in UTC too,
# otherwise expires_at from MySQL and TTLs from Redis drift apart.
default_time_zone = '+00:00'

sql_mode = "ONLY_FULL_GROUP_BY,STRICT_TRANS_TABLES,NO_ZERO_IN_DATE,NO_ZERO_DATE,ERROR_FOR_DIVISION_BY_ZERO,NO_ENGINE_SUBSTITUTION"
